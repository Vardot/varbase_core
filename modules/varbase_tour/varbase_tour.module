<?php

/**
 * @file
 * Contains varbase_tour.module.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\varbase_tour\Hook\VarbaseTourHooks;

/**
 * Implements hook_page_attachments().
 */
#[LegacyHook]
function varbase_tour_page_attachments(array &$page) {
  \Drupal::service(VarbaseTourHooks::class)->pageAttachments($page);
}

/**
 * Implements hook_theme().
 */
#[LegacyHook]
function varbase_tour_theme($existing, $type, $theme, $path) {
  return \Drupal::service(VarbaseTourHooks::class)->theme($existing, $type, $theme, $path);
}

/**
 * Implements hook_page_top().
 */
#[LegacyHook]
function varbase_tour_page_top(array &$page_top) {
  \Drupal::service(VarbaseTourHooks::class)->pageTop($page_top);
}
