<?php

/**
 * @file
 * Install, update and uninstall functions for the Varbase Default content.
 */

use Vardot\Entity\EntityDefinitionUpdateManager;
use Drupal\Component\Serialization\Yaml;
use Drupal\Core\DefaultContent\Finder;
use Drupal\Core\DefaultContent\Importer;
use Drupal\Core\DefaultContent\Existing;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;

/**
 * Implements hook_install().
 */
function varbase_default_content_install() {

  // ---------------------------------------------------------------------------
  // Entity updates to clear up any mismatched entity and/or field definitions
  // And Fix changes were detected in the entity type and field definitions.
  \Drupal::classResolver()
    ->getInstanceFromDefinition(EntityDefinitionUpdateManager::class)
    ->applyUpdates();

  // Ensure the modules whose entities we import are installed.
  \Drupal::service('module_installer')->install(['block', 'block_content', 'menu_link_content']);

  // Ensure the "basic" block content type has its body field before importing
  // block_content demo content. This optional field config
  // (field.field.block_content.basic.body) can be skipped during the Varbase
  // profile install because of config import ordering (the basic block type is
  // created after varbase_core's optional config is imported). Without the body
  // field the core Default Content importer bails with "Field body is unknown"
  // and no demo blocks (the Homepage "Welcome to Varbase" block, etc.) are
  // created.
  $field_manager = \Drupal::service('entity_field.manager');
  $basic_fields = $field_manager->getFieldDefinitions('block_content', 'basic');
  if (!isset($basic_fields['body'])
    && FieldStorageConfig::loadByName('block_content', 'body')
    && !FieldConfig::loadByName('block_content', 'basic', 'body')) {
    $body_config_file = \Drupal::service('extension.list.module')->getPath('varbase_core')
      . '/config/optional/field.field.block_content.basic.body.yml';
    if (file_exists($body_config_file)) {
      FieldConfig::create(Yaml::decode(file_get_contents($body_config_file)))->save();
      $field_manager->clearCachedFieldDefinitions();
    }
  }

  // Import the Varbase starter content via Drupal core Default Content
  // (replaces the contrib default_content module).
  // Import in a guard: in a minimal/isolated environment some referenced
  // config (e.g. text formats provided by varbase_editor) may be absent;
  // don't fatal the module install if a starter entity can't be created.
  try {
    $finder = new Finder(__DIR__ . '/content');
    \Drupal::service(Importer::class)->importContent($finder, Existing::Skip);
  }
  catch (\Exception $e) {
    \Drupal::logger('varbase_default_content')->warning('Skipped some default content: @m', ['@m' => $e->getMessage()]);
  }

  // Set the front page to /node.
  \Drupal::configFactory()->getEditable('system.site')->set('page.front', '/node')->save();

  // Clear cached definitions.
  \Drupal::service('plugin.cache_clearer')->clearCachedDefinitions();

  \Drupal::service('plugin.manager.menu.contextual_link')->clearCachedDefinitions();
  \Drupal::service('plugin.manager.menu.local_task')->clearCachedDefinitions();
  \Drupal::service('plugin.manager.menu.local_action')->clearCachedDefinitions();

  // Invalidating.
  \Drupal::service('cache.menu')->deleteAll();
  \Drupal::service('cache.render')->deleteAll();

  // Rebuilding.
  \Drupal::service('plugin.manager.menu.link')->rebuild();

  // Rebuild permissions. The content access permissions need to be rebuilt.
  // @phpstan-ignore-next-line function.deprecated (needed to rebuild node grants; still available on Drupal 11.4)
  node_access_rebuild();

  // Rebuild the menu router based on all rebuilt data.
  // Important: This rebuild must happen last, so the menu router is guaranteed
  // to be based on up to date information.
  \Drupal::service('router.builder')->rebuild();

  // Resets all static caches.
  drupal_static_reset();
}
