<?php

/**
 * @file
 * Contains varbase_admin.module.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\varbase_admin\Hook\VarbaseAdminHooks;

/**
 * Implements hook_toolbar_alter().
 */
#[LegacyHook]
function varbase_admin_toolbar_alter(&$items) {
  \Drupal::service(VarbaseAdminHooks::class)->toolbarAlter($items);
}

/**
 * Implements hook_form_BASE_FORM_ID_alter().
 */
#[LegacyHook]
function varbase_admin_form_node_type_add_form_alter(array &$form, FormStateInterface $form_state) {
  \Drupal::service(VarbaseAdminHooks::class)->formNodeTypeAddFormAlter($form, $form_state);
}
