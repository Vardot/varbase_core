# Ignore node modules
node_modules

# Ignore vim swp files and gedit temp files
*.swp
*.*~
.vim

# Yarn cache and build artifacts
.yarn/*
.pnp.*

# gitlab-ci-local runner cache (created when running .gitlab-ci-local.yml)
.gitlab-ci-local/

# Eclipse settings files.
.project
.pydevproject
.settings
.buildpath


# Ignore OS settings files.
.DS_Store*
Thumbs.db
ehthumbs.db

# Ignore files generated by PhpStorm.
.idea

# Ignore server stuff.
.bash_history
.bashrc
errors.log
