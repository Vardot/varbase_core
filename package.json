{
  "name": "varbase_core",
  "description": "Provides core components required by other features.",
  "private": true,
  "license": "GPL-2.0-or-later",
  "engines": {
    "yarn": ">= 4.9.3",
    "node": ">= 20.0"
  },
  "scripts": {
    "theme:build:admin": "webpack --progress --config webpack.config.admin.js && prettier --write \"modules/varbase_admin/css/theme/**/*.css\" && stylelint --fix \"modules/varbase_admin/css/theme/**/*.css\"",
    "theme:build": "yarn theme:build:admin",
    "phpcs": "phpcs --standard=./.phpcs.xml .",
    "phpcbf": "phpcbf --standard=./.phpcs.xml .",
    "lint:js": "eslint --ext .js .",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:yaml": "eslint --ext .yml .",
    "spellcheck": "cspell lint ."
  },
  "keywords": [
    "Drupal",
    "Varbase",
    "Varbase Core",
    "SASS",
    "Bootstrap"
  ],
  "author": "Vardot",
  "devDependencies": {
